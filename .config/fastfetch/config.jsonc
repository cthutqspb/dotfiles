            "type": "display",
            "key": " ├󰍹 "
        },
        {
            "type": "board",
            "key": " ├ " 
        },
        {
            "type": "cpu",
            "key": " ├ "
        },
        {
            "type": "gpu",
            "key": " ├󰤽 "
        },
        {
            "type": "memory",
            "key": " ├ "
        },
        {
            "type": "physicalmemory"            
        },
        {
            "type": "custom",
            "format": "\u001b[3;90m└──────────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[3;90m╭─────────────────────── I/O devices ──────────────────────╮"
        },
        {
            "type": "sound",
            "key": " ├󱟛 "
        },
        {
            "type": "command",
            "key": " ├󰍽 ",
            "text": "lsusb | grep '12cf:0c05' | awk -F 'DEXIN ' '{print $2}' | sed 's/ gaming mouse//g'"
        },
        {
            "type": "command",
            "key": " ├ ",
            "text": "lsusb | grep 'fffe:000a' | awk '{print $7, $8}'"
        },
        {
            "type": "custom",
            "format": "\u001b[3;90m└──────────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[3;90m╭─────────────────────── Hard drives ──────────────────────╮"
        },
        {
            "type": "disk",
            "key": " ├ "
        },       
        {
            "type": "custom",
            "format": "\u001b[3;90m└──────────────────────────────────────────────────────────┘"
        },

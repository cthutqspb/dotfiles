            "key": " ├ "
        },      
        {
            "type": "uptime",
            "key": " ├ "
        },
        {
            "type": "wm",
            "key": " ├ "
        },
        {
            "type": "de",
            "key": " ├de "
        },
        {
            "type": "font",
            "key": " ├ "
        },
        {
            "type": "custom",
            "format": "\u001b[3;90m└──────────────────────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "\u001b[3;90m╭──────────────────────── Terminal ────────────────────────╮"
        },
        {
            "type": "terminal",
            "key": " ├ "
        },
        {

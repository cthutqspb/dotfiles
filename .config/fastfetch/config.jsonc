{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "color": {
            "keys": "blue",
            "title": "cyan",
            "separator": "#bb9af7"
        }
    },
    "logo": {
        "type": "kitty",
        "source": "/home/trip/Изображения/Вороны/pirat_obrezan_pomemshe.png",
        "padding": {
            "right": 0
        }
    },
    "modules": [
        //"separator",
        {
            "type": "custom",
            "format": "\u001b[3;90m╭─────────────────────────── OS ───────────────────────────╮"
        },
        { 
            "type": "title",
            "key": " ├ ",
            "keyColor": "\u001b[38;5;111m" // Цвет для ключа
        },     
        {
            "type": "os",
            "key": " ├󰣇 "
        },
        {
            "type": "kernel",
            "key": " ├ "
        },
        {
